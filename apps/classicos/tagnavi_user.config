#! rockbox/tagbrowser/2.0
# The lists behind classicOS's Music menu, read by Rockbox's tagtree in place
# of tagnavi.config (same syntax; see apps/tagnavi.config). The shell draws
# Music itself and opens these by row, so keep this order in step with
# musicSelect() in shell/app.ts.

# Song rows are title, ASCII unit separator (0x1F, invisible here; it can't
# occur in text tags), artist: the host splits them into two lines. Album
# track lists sort by disc and track number, strip that prefix, stay one line.
%format "pp_song"  "%s%s" title canonicalartist
%format "pp_track" "%02d%02d%s" discnum tracknum title %strip = "4"

%menu_start "classicos" "Music"
"Artists"   -> canonicalartist -> album -> title = "pp_track"
"Albums"    -> album -> title = "pp_track"
"Songs"     -> title = "pp_song"

%root_menu "classicos"
